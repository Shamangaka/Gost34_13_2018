module Qalqan.Test

(* Appendix A values and known answers, checked by normalisation while
   type-checking: `fstar.exe Qalqan.Test.fst` fails if any of them differs.
   Values come from resources/gold.txt (Appendix A), reference_kat.txt and
   modes_kat.txt. *)

open FStar.List.Tot
open Qalqan
open Qalqan.Modes
module U8 = FStar.UInt8
module L = FStar.List.Tot

#push-options "--fuel 0 --ifuel 0"

(* S is a permutation and S^-1 its inverse *)
let _ = assert_norm (L.noRepeats sb)
let _ = assert_norm (L.for_all (fun (x: nat) -> inv_sbox (sbox (U8.uint_to_t (x % 256))) = U8.uint_to_t (x % 256)) (range 256))

(* Linear operation (Appendix A, first example) and its inverse *)
let lin_in_128 : list U8.t = [0x63uy; 0x4duy; 0x1fuy; 0x9cuy; 0x6fuy; 0x80uy; 0x8auy; 0x1auy; 0x54uy; 0xbfuy; 0x04uy; 0xe2uy; 0xf5uy; 0xa5uy; 0x72uy; 0xf7uy]
