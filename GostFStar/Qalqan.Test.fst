let _ = assert_norm (linear lin_in_128 false == lin_out_128)
let _ = assert_norm (linear lin_out_128 true == lin_in_128)
let lin_in_256 : list U8.t = [0x63uy; 0x4duy; 0x1fuy; 0x9cuy; 0x6fuy; 0x80uy; 0x8auy; 0x1auy; 0x54uy; 0xbfuy; 0x04uy; 0xe2uy; 0xf5uy; 0xa5uy; 0x72uy; 0xf7uy; 0x1duy; 0xfcuy; 0x44uy; 0x39uy; 0x39uy; 0xc3uy; 0x93uy; 0x4fuy; 0xd7uy; 0x01uy; 0xffuy; 0x50uy; 0xdfuy; 0x4cuy; 0x4buy; 0x34uy]
